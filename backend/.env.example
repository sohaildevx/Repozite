# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Console log level for the Repozite app loggers (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# PostgreSQL Database (NeonDB)
DATABASE_URL=postgresql://user:YOUR_PASSWORD@ep-xxxxx-xxxxx.us-east-2.aws.neon.tech/repozite?sslmode=require

# ---------------------------------------------------------------------------
# GitHub OAuth -- "Sign in with GitHub".
# Create an app at https://github.com/settings/developers  ->  OAuth Apps -> New
#   Homepage URL:            http://127.0.0.1:5173
#   Authorization callback:  http://127.0.0.1:8000/api/auth/github/callback/
# Leave both blank and the button redirects to /login with an explanatory
# message instead of failing. Fill them in HERE (never in .env.example).
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Absolute backend URL for the callback above (no trailing slash).
# Default: http://127.0.0.1:8000 in DEBUG, required in production.
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/auth/github/callback/
# Absolute frontend origin visitors land on after the OAuth round trip
# (no trailing slash). Default: http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
# Set True in production (HTTPS) to mark sessionid + OAuth cookies Secure.
SESSION_COOKIE_SECURE=False
# OAuth rate limits: (attempts per 60s window), per client address.
GITHUB_OAUTH_RATE=10
GITHUB_OAUTH_CALLBACK_RATE=30

# Personal access token for the GitHub REST API used when listing repos,
# fetching files and cloning. Completely separate from the OAuth credentials
# above -- this identifies the app, those identify the visitor. Optional but
# unauthenticated GitHub API calls are limited to 60/hour per IP.
GITHUB_TOKEN=

# NVIDIA Nemotron AI via Nebius Token Factory (OpenAI-compatible inference API)
# Docs verified: https://tokenfactory.nebius.com/docs  (OpenAI SDK + /v1/ base URL)
# Fill these in YOUR .env yourself. This example file is safe to commit;
# your real .env never is (see .gitignore).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Pick a Nemotron ID from YOUR account's catalog (official catalog:
# https://tokenfactory.nebius.com/models/catalog), e.g.:
#   nvidia/nemotron-3-super-120b-a12b          (120B, good for code reasoning)
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B      (30B, faster/cheaper)
# List the IDs enabled on your account (run this yourself in your shell):
#   curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $NEBIUS_API_KEY"
NEBIUS_MODEL=
# Optional: AI request timeout in seconds (default 120). Nemotron is a
# hybrid REASONING model -- it can think for a while before replying, so
# keep this generous (>=60). If your .env still says 30, raise it.
NEBIUS_TIMEOUT=120

# Optional: reasoning effort for the hybrid Nemotron model (default none).
# Official enum: none|minimal|low|medium|high|xhigh. Measured on a real
# issue: low = 15382 hidden reasoning tokens / 225s, minimal = 12946 / 65s
# on an 848-byte file (variance can exceed the completion budget and yield
# an empty truncated reply), none = 0 tokens / ~1s with a valid patch.
# Use minimal|low to opt thinking back in for harder bugs, or "default"
# to omit the parameter entirely (provider default behavior).
NEBIUS_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# Phase 7 -- Agent run (bug fixing) settings.
# All optional; defaults are shown. None of these are secrets -- the API key
# itself stays only in NEBIUS_API_KEY above.
# ---------------------------------------------------------------------------
# Max characters in a run's final_summary
AGENT_MAX_SUMMARY_CHARS=6000
# Max characters of output stored per TestResult row
AGENT_MAX_RESULT_OUTPUT_CHARS=4000
# Max repair attempts per run (1 initial + 1 retry = 2)
AGENT_MAX_REPAIR_ATTEMPTS=2
# Explicitly opt in to running the repo's own tests inside the Docker
# sandbox. Requires a running Docker daemon and SANDBOX_IMAGE to be present
# locally. When disabled (default), test execution stays off and results are
# recorded as "skipped".
AGENT_TEST_EXECUTION=0
# Trusted sandbox image (never a repo-provided Dockerfile)
SANDBOX_IMAGE=python:3.12-slim
# Sandbox wall-clock timeout in seconds
SANDBOX_TIMEOUT_SECONDS=120
# Sandbox resource limits
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
